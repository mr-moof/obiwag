{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "efficiency-handoff.schema.json",
  "title": "Obi efficiency handoff",
  "type": "object",
  "required": ["schema_version", "run_id", "from_phase", "to_phase", "roots", "acceptance_criteria", "settled_facts", "unknowns", "source_artifacts", "independent_read_batches", "overflow_actions", "byte_accounting"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "from_phase": {"type": "integer", "minimum": 0, "maximum": 10},
    "to_phase": {"type": "integer", "minimum": 1, "maximum": 10},
    "roots": {
      "type": "object",
      "required": ["project", "runtime"],
      "properties": {"project": {"type": "string"}, "runtime": {"type": "string"}, "source": {"type": "string"}},
      "additionalProperties": false
    },
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "settled_facts": {"type": "array", "items": {}},
    "unknowns": {"type": "array", "items": {}},
    "source_artifacts": {"type": "array", "items": {"type": "object"}},
    "independent_read_batches": {"type": "array", "items": {"type": "object"}},
    "overflow_actions": {"type": "array", "items": {"type": "object"}},
    "byte_accounting": {"type": "object"}
  },
  "additionalProperties": false
}
