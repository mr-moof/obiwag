{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Obi peer-review scope manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "request_sha256", "capsule_sha256", "files", "excluded", "evidence_comparisons", "totals"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capsule_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "files": {"type": "array"},
    "excluded": {"type": "array"},
    "evidence_comparisons": {"type": "array"},
    "totals": {"type": "object"}
  }
}
